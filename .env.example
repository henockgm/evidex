# Copy to .env (git-ignored) and fill in what you need for local development.

# Public URL of the frontend (Vite dev server in development)
APP_URL=http://localhost:5173
MAILER_FROM="Evidex <no-reply@evidex.local>"

# Google sign-in: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5173/auth/google_oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft sign-in: Entra admin center -> App registrations
# Supported account types: any Entra ID tenant + personal Microsoft accounts
# Redirect URI (Web): http://localhost:5173/auth/entra_id/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Reject passwords that appear in known data breaches (Have I Been Pwned)
PWNED_PASSWORDS_CHECK=true

# AI features (posting extraction). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Model used for AI features; e.g. claude-haiku-5-5 for lower cost
EVIDEX_AI_MODEL=claude-opus-5-5
# AI runs allowed per user per day
EVIDEX_AI_DAILY_LIMIT=20

# Days an application can sit in "applied" with no change before the
# dashboard lists it under "No reply yet"
EVIDEX_NO_REPLY_DAYS=21

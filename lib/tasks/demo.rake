namespace :evidex do
  namespace :demo do
    # Creates the shared demo account on first run. In production:
    # bin/kamal app exec 'bin/rails evidex:demo:reset'
    desc "Create or rebuild the shared demo account from db/demo"
    task reset: :environment do
      user = Demo::Account.reset!
      puts "Demo account #{user.email_address} reset: #{user.job_postings.count} postings, #{user.documents.count} documents."
    end

    # Run in development after generating a report for the first demo posting in the app;
    # writes db/demo/match_report.yml so resets restore it without calling the AI.
    desc "Save the demo's latest match report to db/demo/match_report.yml"
    task export_match_report: :environment do
      user = Demo::Account.user or abort("No demo account. Run evidex:demo:reset first.")
      first_title = YAML.load_file(Demo::Account::DATA.join("postings.yml")).first["title"]
      report = user.job_postings.find_by!(title: first_title).match_reports.where(status: "done").latest_first.first or
        abort("No finished match report for \"#{first_title}\" yet.")
      data = {
        "model" => report.model, "strengths" => report.strengths, "gaps" => report.gaps,
        "matches" => report.matches.includes(citations: :document).map do |match|
          {
            "kind" => match.requirement_kind, "text" => match.requirement_text, "verdict" => match.verdict,
            "reasoning" => match.reasoning,
            "citations" => match.citations.map do |citation|
              { "document" => citation.document&.file&.filename.to_s, "passage_starts_with" => citation.excerpt.first(60) }
            end
          }
        end
      }
      path = Demo::Account::DATA.join("match_report.yml")
      path.write("# Generated by bin/rails evidex:demo:export_match_report from a real report (#{report.model}).\n#{data.to_yaml}")
      puts "Wrote #{path.relative_path_from(Rails.root)} (#{data['matches'].size} requirements)."
    end
  end
end
